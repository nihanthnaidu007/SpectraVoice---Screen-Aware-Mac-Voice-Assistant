# SpectraVoice environment configuration
# Copy this file to `.env` and fill in your values:  cp .env.example .env
# Never commit your real `.env` to version control.

# Required for cloud (OpenAI) mode:
OPENAI_API_KEY="your_openai_api_key_here"

# Optional: enables real-time web search (leave empty to disable):
TAVILY_API_KEY=""

# Optional: pin the LLM provider and skip the selection prompt ("cloud" or "local"):
# LLM_PROVIDER=cloud

# Optional: explicitly grant consent for sending screen captures to the LLM
# provider. Defaults to OFF — without consent SpectraVoice answers without vision.
# SPECTRAVOICE_SCREEN_CONSENT=1
